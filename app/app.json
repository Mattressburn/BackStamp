{
  "expo": {
    "name": "Backstamp",
    "slug": "backstamp",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "backstamp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.backstamp.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Backstamp uses the camera to photograph a dish and the model number on its underside so it can identify the pattern and form.",
        "NSPhotoLibraryUsageDescription": "Backstamp uses your photo library so you can add pictures of pieces already in your collection.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.backstamp.app",
      "adaptiveIcon": {
        "backgroundColor": "#6E7A22",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6E7A22",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112,
          "dark": {
            "backgroundColor": "#231D14",
            "image": "./assets/images/splash-icon-dark.png",
            "imageWidth": 112
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Backstamp uses the camera to photograph a dish and the model number on its underside so it can identify the pattern and form."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9304a800-3b2e-4739-8f0c-61b8c86a1f30"
      }
    },
    "owner": "mattressburns-team"
  }
}
