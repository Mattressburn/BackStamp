# Copy to .env and fill in. Never commit .env.
# A missing optional key disables that one feature; it must not crash the server.

# --- Required ---

# Identification. Whichever of these is set decides the vision provider: Gemini when
# GEMINI_API_KEY is present, otherwise Anthropic. There is deliberately no escalation
# from one to the other yet; routing a low-confidence Gemini result to Anthropic was
# proposed and not approved, and the seam in identify.ts is shaped to allow it later.
# Gemini's free tier permits Google to use submitted content to improve their products
# and the paid tier does not, so shipping on the free tier contradicts this app's own
# privacy design. Use a paid key in production.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Signs our own session tokens. Any long random string; rotating it logs everyone out.
SESSION_SECRET=

# --- Pricing (both optional, but with neither there are no prices at all) ---

# Sold comps. eBay closed its own sold-data API to solo developers, so this is a
# third-party source. Free tier is ~50 requests/month, which is enough because quotes
# are cached per item for a week and shared across every user.
SOLDCOMPS_API_KEY=

# eBay Browse — active listings, the fallback when sold comps are unavailable.
# The app labels which source produced a number, because "sold" and "asking" are
# different claims.
EBAY_APP_ID=
EBAY_CERT_ID=

# --- Optional ---

# Sign in with Google. Apple needs no server-side secret.
GOOGLE_CLIENT_ID=

# Sign in with Apple: the identity token's audience, which is the app's bundle
# identifier. Without it every real Apple sign-in is rejected as a configuration
# error while Apple's own sheet reports success. Measured on a real iPhone,
# 2026-08-12.
APPLE_CLIENT_ID=com.backstamp.app

PORT=8787
DATABASE_PATH=./data/pydex.db
PHOTO_DIR=./data/photos
CATALOG_PATH=../data/catalog.json
