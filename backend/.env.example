# Copy to .env and fill in. Never commit .env.
# A missing optional key disables that one feature; it must not crash the server.

# --- Required ---

# Identification. Vision runs on claude-opus-5.
ANTHROPIC_API_KEY=

# Signs our own session tokens. Any long random string; rotating it logs everyone out.
SESSION_SECRET=

# --- Pricing (both optional, but with neither there are no prices at all) ---

# Sold comps. eBay closed its own sold-data API to solo developers, so this is a
# third-party source. Free tier is ~50 requests/month, which is enough because quotes
# are cached per item for a week and shared across every user.
SOLDCOMPS_API_KEY=

# eBay Browse — active listings, the fallback when sold comps are unavailable.
# The app labels which source produced a number, because "sold" and "asking" are
# different claims.
EBAY_APP_ID=
EBAY_CERT_ID=

# --- Optional ---

# Sign in with Google. Apple needs no server-side secret.
GOOGLE_CLIENT_ID=

PORT=8787
DATABASE_PATH=./data/pydex.db
PHOTO_DIR=./data/photos
CATALOG_PATH=../data/catalog.json
